[gd_resource type="Resource" script_class="Recipe" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/crafting/recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/items/ingredient.gd" id="2_ingredient"]

[sub_resource type="Resource" id="Ingredient_wood"]
script = ExtResource("2_ingredient")
item_id = "wood"
quantity = 2

[sub_resource type="Resource" id="Ingredient_scrap"]
script = ExtResource("2_ingredient")
item_id = "scrap"
quantity = 1

[resource]
script = ExtResource("1_recipe")
id = "knife"
display_name = "Survival Knife"
category = 0
output_item_id = "knife"
output_quantity = 1
ingredients = Array[Ingredient]([SubResource("Ingredient_wood"), SubResource("Ingredient_scrap")])

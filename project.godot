; Engine configuration file.
; Last Haven - open-world post-apocalyptic survival.
; Edited by hand is fine, but the editor UI is safer for most values.

config_version=5

[application]

config/name="Last Haven"
config/description="Open-world post-apocalyptic survival game for mobile."
config/version="0.1.0"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.0431373, 0.0470588, 0.0431373, 1)
boot_splash/show_image=false

[autoload]

GameBootstrap="*res://scripts/core/game_bootstrap.gd"
GameEvents="*res://scripts/core/game_events.gd"
ItemDatabase="*res://scripts/items/item_database.gd"
SaveManager="*res://scripts/save/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="resource"
2d_physics/layer_5="interactable"
2d_physics/layer_6="hitbox"
2d_physics/layer_7="hurtbox_player"
2d_physics/layer_8="hurtbox_enemy"

[physics]

2d/default_gravity=0.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0431373, 0.0470588, 0.0431373, 1)

